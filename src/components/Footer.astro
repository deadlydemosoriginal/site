---
import { socials } from '../lib/socials';

const year = new Date().getFullYear();
const founded = 2024; // per the logo: ESTD 2024, Notts, UK

const columns = [
  {
    title: 'Listen',
    links: [
      { href: '/shows/',     label: 'Show archive' },
      { href: '/playlists/', label: 'Playlists' },
      { href: '/podcast/',   label: 'Podcast' },
    ],
  },
  {
    title: 'Read',
    links: [
      { href: '/articles/', label: 'Articles' },
      { href: '/about/',    label: 'Who we are' },
    ],
  },
  {
    title: 'Elsewhere',
    links: [
      ...socials.map((s) => ({ href: s.url, label: s.label })),
      { href: '/contact/', label: 'Get in touch' },
    ],
  },
];
---

<footer class="foot on-purple">
  <div class="shell">
    <div class="foot__grid">
      <div class="foot__brand">
        <span class="foot__badge" aria-hidden="true"></span>
        <p class="meta foot__tag">
          Independent music content and radio show<br />
          Yorkshire / North West / London, UK &middot; Est. {founded}
        </p>
      </div>

      <div class="foot__cols">
        {columns.map((col) => (
          <div>
            <h2 class="meta foot__coltitle">{col.title}</h2>
            <ul class="foot__list">
              {col.links.map((l) => (
                <li><a href={l.href} class="foot__link">{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <hr class="rule foot__rule" />

    <p class="meta foot__colophon">
      <span>&copy; {year} Deadly Demos &middot; Notts, UK</span>
      <span>Powered by caffiene and determination</span>
    </p>
  </div>
</footer>

<style>
  .foot { padding-block: var(--space-section) 2rem; }

  .foot__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 3rem var(--gutter);
  }

  /* Badge artwork: the purple parts only, drawn black on a transparent PNG.
     It sits on a brand-purple patch so the black has strong contrast against
     the dark footer. */
  .foot__badge {
    display: block;
    box-sizing: content-box;
    width: clamp(6rem, 12vw, 8.5rem);
    aspect-ratio: 942 / 1199;
    padding: 1.25rem;
    background-color: var(--lavender);
    background-image: url('/brand/dd-badge-black.png');
    background-size: contain;
    background-position: center;
    background-origin: content-box;
    background-clip: padding-box;
    background-repeat: no-repeat;
    border-radius: 1rem;
  }

  .foot__tag { margin-top: 1.25rem; }

  .foot__cols {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
  }

  .foot__coltitle { color: var(--fg); margin-bottom: 0.9rem; font-weight: 700; }

  .foot__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }

  .foot__link {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .foot__link:hover { color: var(--fg); text-decoration: underline; }

  .foot__rule { margin-block: 3rem 1.25rem; }

  .foot__colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
</style>
