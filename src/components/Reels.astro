---
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/content';

interface Props {
  limit?: number;
  handle?: string;
}
const { limit = 12, handle = 'deadlydemos' } = Astro.props;

const reels = (await getCollection('reels', (e) => import.meta.env.DEV || !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, limit);
---

{reels.length > 0 && (
  <section class="shell section" data-carousel>
    <h2 class="split-head">
      <span>Deadly</span>
      <span>Domscroll</span>
    </h2>

    <!-- Scroll-snap track: 3 per view on desktop, 2 on tablet, 1 on phones.
         The arrows just scroll the track, so swipe and trackpad still work. -->
    <ul class="reels" data-track tabindex="0" aria-label="Recent Instagram reels">
      {reels.map((reel, i) => (
        <li class="reel">
          <a
            href={reel.data.url}
            class="reel__link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class={`reel__media tone-${reel.data.tone}`}>
              {reel.data.thumbnail ? (
                <img
                  src={reel.data.thumbnail}
                  alt=""
                  class="reel__img"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="reel__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
              )}
              <span class="reel__play" aria-hidden="true"></span>
            </div>

            <p class="meta reel__date">{formatDate(reel.data.date)}</p>
            <p class="reel__caption">{reel.data.caption}</p>
          </a>
        </li>
      ))}
    </ul>

    <div class="reels__foot">
      <a
        class="reels__follow meta"
        href={`https://www.instagram.com/${handle}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        @{handle} on Instagram ↗
      </a>

      <div class="reels__nav">
        <button class="reels__btn" type="button" data-prev aria-label="Previous reels">←</button>
        <button class="reels__btn" type="button" data-next aria-label="Next reels">→</button>
      </div>
    </div>
  </section>
)}

<style>
  .reels {
    --per: 3;
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: flex;
    gap: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .reels::-webkit-scrollbar { display: none; }
  .reels:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  .reel {
    flex: 0 0 calc((100% - var(--gutter) * (var(--per) - 1)) / var(--per));
    min-width: 0;
    scroll-snap-align: start;
  }

  .reel__link { text-decoration: none; color: var(--fg); display: grid; gap: 0.75rem; }

  .reel__media {
    position: relative;
    /* Reels are 9:16 — respect the format rather than cropping to a square. */
    aspect-ratio: 9 / 16;
    background: var(--block-bg);
    color: var(--block-fg);
    overflow: hidden;
    container-type: inline-size;
    display: grid;
    place-items: center;
  }

  .reel__img { width: 100%; height: 100%; object-fit: cover; }

  .reel__num {
    font-family: var(--face-display);
    font-weight: 800;
    font-variation-settings: 'wdth' 75;
    font-size: 42cqw;
    line-height: 0.8;
  }

  /* Magenta play glyph, bottom-left — same transport language as the player. */
  .reel__play {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--magenta);
  }
  .reel__play::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-40%, -50%);
    border-left: 11px solid var(--ink);
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
  }
  .reel__link:hover .reel__play { background: var(--lavender); }

  .reel__caption { font-size: 0.95rem; line-height: 1.35; color: var(--fg-muted); }
  .reel__link:hover .reel__caption { color: var(--fg); }

  .reels__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .reels__follow { color: var(--link); text-decoration: none; }
  .reels__follow:hover { color: var(--accent); }

  .reels__nav { display: flex; gap: 0.5rem; }
  .reels__btn {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    font-family: var(--face-mono);
    font-size: 1.1rem;
    background: none;
    color: var(--fg);
    border: 1px solid var(--rule);
    cursor: pointer;
  }
  .reels__btn:hover:not(:disabled) { background: var(--magenta); color: var(--ink); border-color: var(--magenta); }
  .reels__btn:disabled { opacity: 0.3; cursor: default; }
  /* Nothing to scroll through — hide the arrows entirely. */
  .reels__nav[data-idle] { visibility: hidden; }

  @media (max-width: 900px) { .reels { --per: 2; } }
  @media (max-width: 560px) { .reels { --per: 1; } }

  @media (prefers-reduced-motion: reduce) { .reels { scroll-behavior: auto; } }
</style>

<script>
  // Carousel arrows. Re-bound on every navigation because ClientRouter swaps the body.
  function initReels() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      const track = root.querySelector<HTMLElement>('[data-track]');
      const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-next]');
      if (!track || !prev || !next || root.dataset.bound) return;
      root.dataset.bound = '';

      // Step by one "page" of visible reels, measured from the real layout.
      const step = () => {
        const items = track.children;
        if (items.length < 2) return track.clientWidth;
        const pitch = (items[1] as HTMLElement).offsetLeft - (items[0] as HTMLElement).offsetLeft;
        const per = Math.max(1, Math.round((track.clientWidth + pitch - (items[0] as HTMLElement).offsetWidth) / pitch));
        return pitch * per;
      };

      const update = () => {
        const max = track.scrollWidth - track.clientWidth;
        prev.disabled = track.scrollLeft <= 1;
        next.disabled = track.scrollLeft >= max - 1;
        prev.parentElement!.toggleAttribute('data-idle', max <= 1);
      };

      prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
      next.addEventListener('click', () => track.scrollBy({ left: step() }));
      track.addEventListener('scroll', update, { passive: true });
      new ResizeObserver(update).observe(track);
      update();
    });
  }

  initReels();
  document.addEventListener('astro:page-load', initReels);
</script>
