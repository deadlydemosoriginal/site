---
/**
 * Persistent audio player.
 *
 * Carries `transition:persist` in the layout, so the <audio> node survives
 * client-side navigation and a show keeps playing while you browse. This is
 * the reason the site is built on Astro rather than a plain static generator.
 */
---

<div
  id="dd-player"
  class="player"
  data-state="idle"
  aria-live="polite"
  transition:persist="dd-player"
>
  <div class="player__inner shell">
    <div class="player__transport">
      <button class="player__skip" type="button" data-skip="-15" aria-label="Back 15 seconds">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 4.5V1.5L7.5 5 12 8.5V5.5a7 7 0 1 1-7 7" />
          <text x="12.5" y="15.75">15</text>
        </svg>
      </button>
      <button id="dd-toggle" class="player__btn" type="button" aria-label="Play">
        <span class="player__icon player__icon--play" aria-hidden="true"></span>
        <span class="player__icon player__icon--pause" aria-hidden="true"></span>
      </button>
      <button class="player__skip" type="button" data-skip="30" aria-label="Forward 30 seconds">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 4.5V1.5L16.5 5 12 8.5V5.5a7 7 0 1 0 7 7" />
          <text x="11.5" y="15.75">30</text>
        </svg>
      </button>
    </div>

    <a id="dd-title" class="player__meta" href="/shows/">
      <span id="dd-ep" class="meta player__ep">—</span>
      <span id="dd-name" class="player__name">Nothing playing</span>
    </a>

    <div class="player__scrub">
      <canvas id="dd-wave" class="player__wave" aria-hidden="true"></canvas>
      <div id="dd-prog" class="player__prog"><span id="dd-fill" class="player__fill"></span></div>
      <input
        id="dd-range"
        class="player__range"
        type="range"
        min="0" max="1000" value="0" step="1"
        aria-label="Seek"
      />
    </div>

    <p class="meta player__time">
      <span id="dd-cur">0:00</span><span class="player__sep">/</span><span id="dd-dur">0:00</span>
    </p>

    <button id="dd-close" class="player__close" type="button" aria-label="Close player">&times;</button>
  </div>

  <audio id="dd-audio" preload="none"></audio>
</div>

<style>
  .player {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 150;
    background: var(--ink-raised);
    border-top: 1px solid var(--rule);
    transform: translateY(100%);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .player[data-state='loaded'],
  .player[data-state='playing'] { transform: translateY(0); }

  .player__inner {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding-block: 0.7rem;
  }

  .player__btn {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    background: var(--magenta);
    color: var(--ink);
    border: 0;
    cursor: pointer;
  }
  .player__btn:hover { background: var(--lavender); }

  /* Skip back/forward sit either side of play as one compact group, so they
     take as little width as possible from the waveform. */
  .player__transport { flex: none; display: flex; align-items: center; gap: 0.15rem; }
  .player__skip {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    padding: 0;
    background: none;
    border: 0;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .player__skip:hover { color: var(--fg); }
  .player__skip svg { width: 1.75rem; height: 1.75rem; overflow: visible; }
  .player__skip path { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .player__skip text {
    fill: currentColor;
    font-family: var(--face-mono);
    font-size: 7px;
    font-weight: 700;
    text-anchor: middle;
  }

  .player__icon--play {
    width: 0; height: 0;
    border-left: 11px solid currentColor;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    margin-left: 3px;
  }
  .player__icon--pause {
    display: none;
    width: 12px; height: 14px;
    border-left: 4px solid currentColor;
    border-right: 4px solid currentColor;
  }
  .player[data-state='playing'] .player__icon--play { display: none; }
  .player[data-state='playing'] .player__icon--pause { display: block; }

  .player__meta {
    flex: none;
    max-width: 24ch;
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
    color: var(--fg);
  }
  .player__ep { line-height: 1; }
  .player__name {
    font-family: var(--face-display);
    font-weight: 700;
    font-variation-settings: 'wdth' 85;
    font-size: 1rem;
    line-height: 1.05;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .player__scrub {
    position: relative;
    flex: 1 1 auto;
    height: 2.25rem;
    display: flex;
    align-items: center;
    min-width: 4rem;
  }

  .player[data-wave='true'] .player__scrub { height: clamp(2.75rem, 6vw, 3.25rem); }
  .player__wave { position: absolute; inset: 0; width: 100%; height: 100%; display: none; }
  .player[data-wave='true'] .player__wave { display: block; }
  .player[data-wave='true'] .player__prog { display: none; }

  .player__prog { position: absolute; inset-inline: 0; height: 3px; background: var(--rule); }
  .player__fill { display: block; height: 100%; width: 0%; background: var(--lavender); }

  /* Transparent range sits on top so seeking is keyboard accessible. */
  .player__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .player__range:focus-visible { opacity: 1; }

  .player__time { flex: none; display: flex; gap: 0.4rem; white-space: nowrap; }
  .player__sep { opacity: 0.4; }

  .player__close {
    flex: none;
    background: none;
    border: 0;
    color: var(--fg-muted);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
  }
  .player__close:hover { color: var(--fg); }

  @media (max-width: 700px) {
    .player__meta { max-width: 14ch; }
    .player__time { font-size: 0.65rem; }
  }

  /* Below ~560px a single row cannot hold the title, and hiding it meant you
     could not see what was playing on the device most people listen on.
     Two rows instead: transport + title, then a full-width scrubber. */
  @media (max-width: 560px) {
    .player__inner {
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'btn  meta  close'
        'scrub scrub time';
      gap: 0.5rem 0.75rem;
      align-items: center;
      padding-block: 0.6rem;
    }

    .player__transport { grid-area: btn; }
    .player__meta  { grid-area: meta; max-width: none; min-width: 0; }
    .player__close { grid-area: close; }
    .player__scrub { grid-area: scrub; height: 1.6rem; }
    .player__time  { grid-area: time; justify-self: end; }

    .player__name { font-size: 0.95rem; }
  }
</style>

<script>
  // Guarded so ClientRouter navigations don't re-bind or reset playback.
  if (!(window as any).__ddPlayer) {
    const el = (id: string) => document.getElementById(id)!;

    const root = el('dd-player');
    const audio = el('dd-audio') as HTMLAudioElement;
    const toggle = el('dd-toggle') as HTMLButtonElement;
    const range = el('dd-range') as HTMLInputElement;
    const fill = el('dd-fill');
    const wave = el('dd-wave') as HTMLCanvasElement;
    const curEl = el('dd-cur');
    const durEl = el('dd-dur');
    const epEl = el('dd-ep');
    const nameEl = el('dd-name');
    const titleLink = el('dd-title') as HTMLAnchorElement;
    const closeBtn = el('dd-close');

    let peaks: number[] = [];
    let slug = '';
    let seen = new Set<number>();

    // `like` is the show's length: the current time is written in the same
    // shape (0:59:59 rather than 59:59 in a 2-hour show, 09:59 in a 45-minute
    // one) so the readout never changes width and the waveform beside it
    // doesn't jump when the clock rolls past 10 minutes or an hour.
    const fmt = (s: number, like = s) => {
      if (!isFinite(s) || s < 0) s = 0;
      if (!isFinite(like) || like < s) like = s;
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      const sec = String(Math.floor(s % 60)).padStart(2, '0');
      if (like >= 3600) return `${h}:${String(m).padStart(2, '0')}:${sec}`;
      return `${like >= 600 ? String(m).padStart(2, '0') : m}:${sec}`;
    };

    const track = (event: string) => {
      const u = (window as any).umami;
      if (u && typeof u.track === 'function') u.track(event, { show: slug });
    };

    // While the seek bar is being dragged we only preview the position, and
    // after letting go we keep showing the target until the audio catches up.
    // Seeking on every pixel of a drag restarts the download each time (a long
    // MP3 then never buffers and sits silent), and repainting from
    // audio.currentTime mid-drag made the playhead spring back.
    let scrubTo: number | null = null; // being dragged
    let pendingSeek: number | null = null; // released, waiting for the seek to land
    const shownTime = () => scrubTo ?? pendingSeek ?? audio.currentTime;
    const seek = (t: number) => {
      if (!isFinite(audio.duration)) return;
      t = Math.max(0, Math.min(t, audio.duration - 0.5));
      pendingSeek = t;
      audio.currentTime = t;
      paint();
    };

    const drawWave = () => {
      if (!peaks.length) return;
      const dpr = window.devicePixelRatio || 1;
      const w = wave.clientWidth;
      const h = wave.clientHeight;
      if (!w || !h) return;
      wave.width = w * dpr;
      wave.height = h * dpr;
      const ctx = wave.getContext('2d');
      if (!ctx) return;
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, w, h);

      const styles = getComputedStyle(document.documentElement);
      const done = styles.getPropertyValue('--lavender').trim() || '#A551E4';
      const todo = styles.getPropertyValue('--paper').trim() || '#FAFAFA';
      const pct = audio.duration ? shownTime() / audio.duration : 0;

      // Spread the bars across the full width whatever the screen size, and
      // drop the gap when they get too thin for one (narrow phones).
      const n = peaks.length;
      const step = w / n;
      const gap = step >= 3 ? 1 : 0;
      const barW = Math.max(0.5, step - gap);
      peaks.forEach((p, i) => {
        // Lift quiet passages a little so talk segments still read as shape.
        const bh = Math.max(2, Math.pow(p, 0.75) * h);
        const played = (i + 0.5) / n < pct;
        ctx.globalAlpha = played ? 1 : 0.28;
        ctx.fillStyle = played ? done : todo;
        ctx.fillRect(i * step, (h - bh) / 2, barW, bh);
      });

      // Playhead.
      if (pct > 0) {
        ctx.globalAlpha = 1;
        ctx.fillStyle = todo;
        ctx.fillRect(Math.min(w - 2, pct * w), 0, 2, h);
      }
    };

    const paint = () => {
      const d = audio.duration;
      const c = shownTime();
      curEl.textContent = fmt(c, d);
      if (isFinite(d)) durEl.textContent = fmt(d);
      const pct = d ? c / d : 0;
      if (scrubTo === null) range.value = String(Math.round(pct * 1000));
      fill.style.width = `${pct * 100}%`;
      if (peaks.length) drawWave();

      // Listen-through milestones — this is what a custom player buys us
      // that an embedded third-party widget never would. Counted from what's
      // actually been reached, not a drag preview.
      const heard = d ? (audio.currentTime / d) * 100 : 0;
      [25, 50, 75].forEach((m) => {
        if (heard >= m && !seen.has(m)) {
          seen.add(m);
          track(`show_progress_${m}`);
        }
      });
    };

    const setHeight = () => {
      const h = root.getBoundingClientRect().height;
      document.documentElement.style.setProperty('--player-h', `${h}px`);
    };

    const api = {
      load(opts: { src: string; title: string; episode?: number; href?: string; slug?: string; peaks?: number[] }) {
        const same = audio.src === opts.src;
        // Same show started again from a page that knows its waveform (e.g.
        // first played from the shows list): upgrade the progress bar.
        if (same && !peaks.length && opts.peaks?.length) {
          peaks = opts.peaks;
          root.setAttribute('data-wave', 'true');
          setHeight();
          drawWave();
        }
        if (!same) {
          audio.src = opts.src;
          scrubTo = pendingSeek = null;
          peaks = opts.peaks || [];
          slug = opts.slug || opts.title;
          seen = new Set();
          root.setAttribute('data-wave', peaks.length ? 'true' : 'false');
          nameEl.textContent = opts.title;
          epEl.textContent = opts.episode !== undefined ? `№ ${opts.episode}` : 'Show';
          if (opts.href) titleLink.href = opts.href;
          durEl.textContent = '0:00';
          curEl.textContent = '0:00';
        }
        root.setAttribute('data-state', 'loaded');
        setHeight();
        audio.play().catch(() => {});
      },
      toggle() {
        if (audio.paused) audio.play().catch(() => {});
        else audio.pause();
      },
      seekTo(seconds: number) {
        seek(seconds);
      },
      get audio() { return audio; },
    };

    (window as any).__ddPlayer = api;
    (window as any).ddPlayer = api;

    toggle.addEventListener('click', () => api.toggle());

    audio.addEventListener('play', () => {
      root.setAttribute('data-state', 'playing');
      toggle.setAttribute('aria-label', 'Pause');
      track('show_play');
    });
    audio.addEventListener('pause', () => {
      root.setAttribute('data-state', 'loaded');
      toggle.setAttribute('aria-label', 'Play');
    });
    audio.addEventListener('ended', () => track('show_complete'));
    audio.addEventListener('timeupdate', paint);
    audio.addEventListener('loadedmetadata', () => { paint(); setHeight(); });

    root.querySelectorAll<HTMLButtonElement>('[data-skip]').forEach((btn) =>
      btn.addEventListener('click', () => {
        seek(shownTime() + Number(btn.dataset.skip));
      }),
    );

    range.addEventListener('input', () => {
      if (!isFinite(audio.duration)) return;
      scrubTo = (Number(range.value) / 1000) * audio.duration;
      paint();
    });
    // One real seek when the drag ends. `change` covers mouse, touch and
    // keyboard; the pointer/blur events catch a release that didn't move it.
    const commitScrub = () => {
      if (scrubTo === null) return;
      const t = scrubTo;
      scrubTo = null;
      seek(t);
    };
    ['change', 'pointerup', 'pointercancel', 'blur'].forEach((ev) => range.addEventListener(ev, commitScrub));
    audio.addEventListener('seeked', () => {
      pendingSeek = null;
      paint();
    });

    closeBtn.addEventListener('click', () => {
      audio.pause();
      root.setAttribute('data-state', 'idle');
      document.documentElement.style.setProperty('--player-h', '0px');
    });

    window.addEventListener('resize', () => { drawWave(); setHeight(); });

    // Delegated: any [data-audio] control anywhere on the site starts playback.
    // Bound to document so it survives ClientRouter body swaps.
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-audio]');
      if (!btn) return;
      e.preventDefault();
      const raw = btn.getAttribute('data-peaks');
      api.load({
        src: btn.getAttribute('data-audio')!,
        title: btn.getAttribute('data-title') || 'Untitled',
        episode: btn.hasAttribute('data-episode') ? Number(btn.getAttribute('data-episode')) : undefined,
        href: btn.getAttribute('data-href') || undefined,
        slug: btn.getAttribute('data-slug') || undefined,
        peaks: raw ? JSON.parse(raw) : [],
      });
    });

    // Tracklist timestamps seek the running show.
    document.addEventListener('click', (e) => {
      const cue = (e.target as HTMLElement).closest<HTMLElement>('[data-seek]');
      if (!cue) return;
      e.preventDefault();
      api.seekTo(Number(cue.getAttribute('data-seek')));
    });
  }
</script>
