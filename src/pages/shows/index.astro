---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { getShows, resolveMembers, formatDate, collectTags } from '../../lib/content';

const shows = await getShows();
const allTags = collectTags(shows);
// Frequency-ordered, so the head is the "top used" row and the rest go in the More menu.
const TOP_TAGS = 8;
const topTags = allTags.slice(0, TOP_TAGS);
const moreTags = allTags.slice(TOP_TAGS);

const rows = await Promise.all(
  shows.map(async (show) => ({
    show,
    hosts: (await resolveMembers(show.data.hosts)).map((m) => m.data.name).join(' & '),
  })),
);
---

<Base
  title="Show archive"
  description="Every Deadly Demos radio show, archived with tracklists."
>
  <section class="shell head">
    <p class="meta head__eyebrow">
      <span>The archive</span>
      <span>{shows.length} shows</span>
    </p>
    <h1 class="head__title">Show<br /><span class="head__title--wide">archive</span></h1>
    <p class="head__lead">
      Everything we have broadcast, in full, with tracklists.
    </p>
  </section>

  <!-- Client-side filter: no framework, just hidden attributes. -->
  <section class="shell filters">
    <div class="filters__row" role="group" aria-label="Filter shows by tag">
      <button class="chip" type="button" data-filter="*" aria-pressed="true">All</button>
      {topTags.map(({ tag, count }) => (
        <button class="chip" type="button" data-filter={tag} aria-pressed="false">
          {tag} <span class="chip__count">{count}</span>
        </button>
      ))}
      {moreTags.length > 0 && (
        <div class="more">
          <button
            class="chip more__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="more-tags"
            data-more-toggle
          >
            <span data-more-label>More</span> <span class="chip__count">{moreTags.length}</span> <span aria-hidden="true">▾</span>
          </button>
          <div class="more__panel" id="more-tags" hidden>
            {moreTags.map(({ tag, count }) => (
              <button class="chip" type="button" data-filter={tag} aria-pressed="false">
                {tag} <span class="chip__count">{count}</span>
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <hr class="rule" />

  <section class="shell section">
    <ol class="list" id="show-list">
      {rows.map(({ show, hosts }, i) => (
        <li
          class="row"
          data-tags={JSON.stringify(show.data.tags)}
        >
          <a href={`/shows/${show.id}/`} class="row__link">
            <span class="meta row__index">{String(shows.length - i).padStart(3, '0')}</span>

            <Cover
              class="row__cover"
              artwork={show.data.artwork}
              number={show.data.episode}
              title={show.data.title}
              tone={show.data.tone}
            />

            <span class="row__body">
              <span class="meta row__meta">
                {formatDate(show.data.date)} · {hosts}
                {show.data.duration && <> · {show.data.duration}</>}
              </span>
              <span class="row__title">{show.data.title}</span>
              <span class="row__desc">{show.data.description}</span>
              <span class="tags">
                {show.data.tags.map((t) => <span class="tag">{t}</span>)}
              </span>
            </span>
          </a>

          {show.data.audioUrl && (
            <button
              class="row__play"
              type="button"
              data-audio={show.data.audioUrl}
              data-title={show.data.title}
              data-episode={show.data.episode}
              data-slug={show.id}
              data-href={`/shows/${show.id}/`}
              data-peaks={show.data.peaks ? JSON.stringify(show.data.peaks) : undefined}
              aria-label={`Play ${show.data.title}`}
            >
              <span class="row__playicon" aria-hidden="true"></span>
            </button>
          )}
        </li>
      ))}
    </ol>

    <p class="meta empty" id="show-empty" hidden>No shows with that tag.</p>
  </section>
</Base>

<style>
  .head { padding-block: clamp(2rem, 5vw, 4rem) 2rem; }
  .head__eyebrow { display: flex; justify-content: space-between; padding-bottom: 1.5rem; }
  .head__title {
    font-size: var(--step-xl);
    text-transform: uppercase;
    line-height: 0.84;
    font-variation-settings: 'wdth' 75;
  }
  .head__title--wide { font-variation-settings: 'wdth' 100; color: var(--lavender); }
  .head__lead { max-width: 46ch; margin-top: 1.5rem; color: var(--fg-muted); font-size: var(--step-s); }

  .filters { padding-bottom: 1.5rem; }
  .filters__row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    font-family: var(--face-mono);
    font-size: var(--step-meta);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    background: none;
    border: 1px solid var(--rule);
    color: var(--fg-muted);
    padding: 0.4rem 0.75rem;
    cursor: pointer;
    min-height: 2.75rem;
  }
  .chip:hover { color: var(--fg); border-color: var(--fg-muted); }
  .chip[aria-pressed='true'] {
    background: var(--fg);
    color: var(--ink);
    border-color: var(--fg);
  }
  .chip__count { opacity: 0.5; }

  .more { position: relative; }
  .more__toggle[data-has-selection='true'] {
    border-color: var(--fg);
    color: var(--fg);
  }
  .more__panel {
    position: absolute;
    z-index: 5;
    top: calc(100% + 0.5rem);
    left: 0;
    width: min(32rem, calc(100vw - 2 * var(--gutter)));
    max-height: 18rem;
    overflow-y: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.75rem;
    background: var(--ink);
    border: 1px solid var(--rule);
  }
  .more__panel[hidden] { display: none; }

  .list { list-style: none; padding: 0; margin: 0; }

  .row {
    position: relative;
    border-bottom: var(--hair);
  }
  .row[hidden] { display: none; }

  .row__link {
    display: grid;
    grid-template-columns: 3rem 8rem 1fr;
    gap: var(--gutter);
    align-items: start;
    padding-block: 1.5rem;
    padding-right: 4rem;
    text-decoration: none;
    color: var(--fg);
  }
  .row__link:hover .row__title { color: var(--lavender); }

  .row__index { padding-top: 0.35rem; }
  .row__cover { width: 8rem; }

  .row__body { display: grid; gap: 0.6rem; align-content: start; }
  .row__title {
    font-family: var(--face-display);
    font-weight: 800;
    font-size: var(--step-m);
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-variation-settings: 'wdth' 90;
  }
  .row__desc { max-width: 60ch; color: var(--fg-muted); font-size: 0.95rem; }

  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tag {
    font-family: var(--face-mono);
    font-size: var(--step-meta);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    border: 1px solid var(--rule);
    padding: 0.25rem 0.5rem;
    color: var(--fg-muted);
  }

  .row__play {
    position: absolute;
    top: 1.5rem;
    right: 0;
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    background: var(--magenta);
    color: var(--ink);
    border: 0;
    cursor: pointer;
  }
  .row__play:hover { background: var(--lavender); }
  .row__playicon {
    width: 0; height: 0;
    border-left: 12px solid currentColor;
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
    margin-left: 3px;
  }

  .empty { padding-block: 3rem; }

  @media (max-width: 700px) {
    .row__link { grid-template-columns: 5rem 1fr; padding-right: 0; }
    .row__index { display: none; }
    .row__cover { width: 5rem; }
    .row__play { position: static; margin-bottom: 1.5rem; }
  }
</style>

<script>
  // Tag filter. Re-bound on every navigation because ClientRouter swaps the body.
  function initShowFilter() {
    const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const rows = document.querySelectorAll<HTMLLIElement>('#show-list .row');
    const empty = document.getElementById('show-empty');
    const toggle = document.querySelector<HTMLButtonElement>('[data-more-toggle]');
    const label = document.querySelector<HTMLElement>('[data-more-label]');
    const panel = document.getElementById('more-tags');
    if (!chips.length || !rows.length) return;

    const setPanel = (open: boolean) => {
      if (!toggle || !panel) return;
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };
    // Assigned, not added: init runs twice on first load.
    if (toggle) toggle.onclick = () => setPanel(panel!.hidden);

    chips.forEach((chip) => {
      chip.onclick = () => {
        const want = chip.dataset.filter!;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));

        // Surface a tag picked from the overflow menu on the toggle itself.
        const fromMore = !!panel?.contains(chip);
        if (toggle && label) {
          label.textContent = fromMore ? want : 'More';
          toggle.dataset.hasSelection = String(fromMore);
        }
        setPanel(false);

        let shown = 0;
        rows.forEach((row) => {
          const tags: string[] = JSON.parse(row.dataset.tags || '[]');
          const match = want === '*' || tags.includes(want);
          row.hidden = !match;
          if (match) shown++;
        });
        if (empty) empty.hidden = shown > 0;
      };
    });
  }

  // Registered once (not per navigation); looks the menu up fresh each time.
  document.addEventListener('click', (e) => {
    const panel = document.getElementById('more-tags');
    if (panel && !panel.hidden && !(e.target as Element).closest('.more')) {
      panel.hidden = true;
      document.querySelector('[data-more-toggle]')?.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('keydown', (e) => {
    const panel = document.getElementById('more-tags');
    if (e.key === 'Escape' && panel && !panel.hidden) {
      panel.hidden = true;
      const toggle = document.querySelector<HTMLButtonElement>('[data-more-toggle]');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });

  initShowFilter();
  document.addEventListener('astro:page-load', initShowFilter);
</script>
